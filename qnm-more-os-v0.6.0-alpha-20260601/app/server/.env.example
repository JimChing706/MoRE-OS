# MoRE v3.0 Backend Environment Configuration
# Copy this file to .env and fill in your configuration

# ============================================
# LM Studio (本地模型 - 推荐使用)
# ============================================
# LM Studio 提供 OpenAI 兼容的 API，是最简单的本地部署方案
# 下载地址: https://lmstudio.ai/
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-4-coder

# ============================================
# OpenAI API Configuration
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Anthropic API Configuration
# ============================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Ollama Configuration (本地模型备选)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============================================
# Server Configuration
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# ============================================
# Redis Configuration (可选，用于状态持久化)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
