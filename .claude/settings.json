{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make format*)",
      "Bash(make typecheck*)",
      "Bash(make health*)",
      "Bash(make status*)",
      "Bash(.venv/bin/python -m pytest *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git checkout -- *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.py) .venv/bin/ruff format \"$f\" >/dev/null 2>&1 || true;; esac; }",
            "timeout": 30,
            "statusMessage": "ruff format"
          }
        ]
      }
    ]
  },
  "language": "中文",
  "fileCheckpointingEnabled": true,
  "slashCommands": [
    {
      "name": "test",
      "description": "Run Python test suite",
      "command": "make test"
    },
    {
      "name": "test-cov",
      "description": "Run tests with coverage",
      "command": "make test-cov"
    },
    {
      "name": "lint",
      "description": "Run ruff linter",
      "command": "make lint"
    },
    {
      "name": "format",
      "description": "Auto-format Python files with ruff",
      "command": "make format"
    },
    {
      "name": "typecheck",
      "description": "Run mypy type checker",
      "command": "make typecheck"
    },
    {
      "name": "health",
      "description": "API health check",
      "command": "make health"
    },
    {
      "name": "frontend-test",
      "description": "Run frontend tests",
      "command": "cd app && npm test"
    },
    {
      "name": "frontend-lint",
      "description": "Run frontend ESLint",
      "command": "cd app && npm run lint"
    },
    {
      "name": "frontend-tsc",
      "description": "TypeScript type check",
      "command": "cd app && npx tsc -b --noEmit"
    },
    {
      "name": "serve",
      "description": "Start API server (foreground)",
      "command": "make serve"
    },
    {
      "name": "status",
      "description": "Show running processes and port usage",
      "command": "make status"
    },
    {
      "name": "check-env",
      "description": "Verify development environment",
      "command": "make check-env"
    }
  ],
  "customInstructions": "This is a Python monorepo with two main components: more_core/ (backend API) and app/ (React frontend). Always verify your working directory matches the component you're modifying. For Python, always typecheck with mypy after changes. Use relative imports (from ..x.y import Z) within the more_core package. Raise typed exceptions from core/errors.py, never generic Exception."
}
