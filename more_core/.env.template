# ============================================================
# QNMing MoRE OS — Environment Configuration Template
# ============================================================
# Copy to .env and customize:
#   cp more_core/.env.template more_core/.env
# ============================================================

# ── LLM Provider: LM Studio (primary, local — Ornith-1.5) ──
MORE_LMSTUDIO_ENDPOINT=http://localhost:1234/v1
MORE_LMSTUDIO_MODEL=ornith-1.5-35b-a3b

# ── 逐级降智阶梯 (tier ladder; 格式 provider:model) ──
# 基于本地实测: 35B MoE 生成速度实际快于 9B dense; ornith/qwen 推理模型
# thinking 无法经 API 关闭 (每次请求烧 30~150+ 推理 token)。T2/T3 避开
# thinking 模型以省延迟; T0 需要足量 max_tokens 预算。
# 裸模型名 (不带 provider: 前缀) 会沿用该 tier 默认 provider。
MORE_TIER_0_MODEL=lmstudio:qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled
MORE_TIER_1_MODEL=lmstudio:ornith-1.5-35b-a3b
MORE_TIER_2_MODEL=lmstudio:ornith-ai/ornith-1.5-9b
# T2 无 thinking 替代 (更快更干净): lmstudio:bonsai-8b
MORE_TIER_3_MODEL=ollama:qwen2.5:7b

# ── LLM Provider: Ollama (fallback, local) ──
MORE_OLLAMA_ENDPOINT=http://localhost:11434
MORE_OLLAMA_MODEL=qwen2.5:7b

