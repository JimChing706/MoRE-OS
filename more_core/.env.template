# ============================================================
# QNMing MoRE OS — Environment Configuration Template
# ============================================================
# Copy to .env and customize:
#   cp more_core/.env.template more_core/.env
# ============================================================

# ── LLM Provider: LM Studio (primary, local) ──
MORE_LMSTUDIO_ENDPOINT=http://localhost:1234/v1
MORE_LMSTUDIO_MODEL=

# ── LLM Provider: Ollama (fallback, local) ──
MORE_OLLAMA_ENDPOINT=http://localhost:11434
MORE_OLLAMA_MODEL=qwen2.5:7b

# ── LLM Provider: OpenAI / DeepSeek / any OpenAI-compatible API ──
