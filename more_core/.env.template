# ── LLM Provider: llama.cpp (local GGUF — Qwen3.8-27B on Mac 48GB) ──
# 需要先安装 llama.cpp 并下载模型:
#   bash scripts/install-llamacpp.sh    # 编译 llama.cpp (qwen3_5 支持)
#   bash scripts/llamacpp-server.sh download
#   bash scripts/llamacpp-server.sh start
# MORE_LLAMACPP_ENDPOINT=http://localhost:8090/v1
# MORE_LLAMACPP_MODEL=qwen3.8-27b
# MORE_LLAMACPP_API_KEY=EMPTY
# MORE_LLAMACPP_TIMEOUT=120

# ── Mock provider (auto-enabled when no real providers are configured) ──
# MORE_USE_MOCK=1

# ── Fallback chain (comma-separated, first is primary) ──
# 本地阶梯: llamacpp (Qwen3.8-27B) → lmstudio (35B MoE) → ollama (7B)
# MORE_LLM_FALLBACK_CHAIN=llamacpp,lmstudio,ollama
MORE_LLM_FALLBACK_CHAIN=lmstudio,ollama

# ── Feature Gates (1 = enabled, 0 = disabled) ──
MORE_ENABLE_SYMBOLIC=1
MORE_ENABLE_EVOLUTION=0
MORE_ENABLE_METACOGNITION=0
MORE_ENABLE_EVOLUTION_LLM_VARIANTS=0
MORE_STRICT_ONTOLOGY=1
MORE_CODEGEN_CONTEXT=1
# Best-of-k candidate validation for code generation (1 = off; >1 = k candidates)
MORE_CODEGEN_CANDIDATES=1
# Multi-agent code review panel (Self-Audit) over generated code (1 = on, 0 = off)
MORE_CODEGEN_REVIEW=0

# ── Data Paths (SQLite) ──
MORE_MEMORY_DB=data/memory.db
MORE_EVOLUTION_DB=data/evolution.db
MORE_AUDIT_LOG=logs/audit.jsonl
MORE_PLUGIN_DIR=plugins
MORE_LOG_DIR=logs

# ── API Server ──
# MORE_HOST=0.0.0.0
# MORE_PORT=8011

# ── Rate Limiting ──
# MORE_RATE_LIMIT_RPS=10
# MORE_RATE_LIMIT_BURST=20

# ── Cache ──
# MORE_CACHE_MAX_SIZE=500
# MORE_CACHE_TTL_SECONDS=3600

# ── Sandbox ──
# MORE_SANDBOX_TIMEOUT=30
# MORE_SANDBOX_MEM_MB=512

# ── API Security ──
# Generate: python -c "import secrets;print('sk-more-os-'+secrets.token_urlsafe(32))"
# Format:   "sk-more-os-" prefix, >=16 chars total. See docs/API_KEY.md.
# Unset = dev mode (unauthenticated, logs a warning). Never commit a real
# key here — write it to more_core/.env (git-ignored) or export it.
# MORE_API_KEY=sk-more-os-...      # API key for Bearer-token auth (all routers)
# MORE_MCP_KEY=                    # MCP server key (falls back to MORE_API_KEY)
# MORE_REQUIRE_API_KEY=0           # 1 = refuse to boot when the key is missing/invalid

# ── CORS (comma-separated origins) ──
# MORE_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# ── Admin Users ──
# MORE_ADMIN_USERS=admin
