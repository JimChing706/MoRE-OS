# ============================================================
# QNMing MoRE OS — Environment Configuration Template
# ============================================================
# Copy this file to more_core/.env and fill in your values:
#   cp more_core/.env.template more_core/.env
# ============================================================

# ── LLM Provider: LM Studio (primary, local) ──
# LM Studio must be running and serving a model on port 1234.
# Download models via LM Studio GUI → Search → Download → Load.
MORE_LMSTUDIO_ENDPOINT=http://localhost:1234/v1
MORE_LMSTUDIO_MODEL=qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled

# ── LLM Provider: Ollama (fallback, local) ──
# Install: brew install ollama && ollama serve
# Pull model: ollama pull qwen2.5:7b
# List models: ollama list
MORE_OLLAMA_ENDPOINT=http://localhost:11434
MORE_OLLAMA_MODEL=qwen2.5:7b

# ── LLM Provider: DeepSeek (optional, cloud) ──
# Register: https://platform.deepseek.com
# Models: deepseek-chat | deepseek-reasoner | deepseek-chat-v3
# Enable thinking tokens: set model=deepseek-reasoner
MORE_DEEPSEEK_ENDPOINT=https://api.deepseek.com
MORE_DEEPSEEK_MODEL=deepseek-chat
MORE_DEEPSEEK_API_KEY=sk-...

# ── Fallback chain (comma-separated, first = primary) ──
# Providers are tried in order; next is used if current fails.
MORE_LLM_FALLBACK_CHAIN=lmstudio,ollama

# ── Feature Gates (1 = enabled, 0 = disabled) ──
MORE_ENABLE_SYMBOLIC=1
MORE_ENABLE_EVOLUTION=1
MORE_ENABLE_METACOGNITION=1

# ── Persistence (SQLite) ──
MORE_MEMORY_DB=data/memory.db
MORE_EVOLUTION_DB=data/evolution.db

# ── API Server ──
# More configurable via CLI: more-os serve --host 0.0.0.0 --port 8011
# MORE_HOST=0.0.0.0
# MORE_PORT=8011

# ── Rate Limiting ──
# MORE_RATE_LIMIT_RPS=10
# MORE_RATE_LIMIT_BURST=20

# ── Cache ──
# MORE_CACHE_MAX_SIZE=500
# MORE_CACHE_TTL_SECONDS=3600

# ── Sandbox ──
# MORE_SANDBOX_TIMEOUT_S=30
# MORE_SANDBOX_MEMORY_MB=512

# ── Plugins Directory ──
# MORE_PLUGIN_DIR=plugins

# ── CORS (comma-separated origins) ──
# MORE_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# ── Admin Users (comma-separated) ──
# MORE_ADMIN_USERS=admin
