# QNMing MoRE OS - LM Studio 配置
# 复制此文件为 .env 并根据需要调整

# LM Studio API 端点
MORE_LMSTUDIO_ENDPOINT=http://localhost:1234/v1
MORE_LMSTUDIO_MODEL=local-model

# 推荐模型配置 (按任务类型)
# 快速任务 (代码/NLP/分析): bonsai-8b
# 复杂任务 (架构/规划): qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled

# 可用模型列表 (来自 LM Studio):
# bonsai-8b                    # 快速响应，适合简单任务
# gemma-4-coder                # 代码专用
# ruvltra-claude-code          # 代码专用
# gemma-4-26b-a4b-it-claude-opus-distill  # 均衡
# gemma-4-31b-it-claude-opus-distill-v2   # 强推理
# qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled  # 最强推理

# Ollama 配置 (备用)
# MORE_OLLAMA_ENDPOINT=http://localhost:11434
# MORE_OLLAMA_MODEL=qwen2.5:7b

# ── API 密钥认证 ──────────────────────────────────────────────────
# 留空 = 开发模式（API 不鉴权，启动时告警）。生成方式见 docs/API_KEY.md：
#   python -c "import secrets;print('sk-more-os-'+secrets.token_urlsafe(32))"
# 格式要求：sk-more-os- 前缀 + >=16 字符。
# 切勿把真实密钥写入本文件（本文件会被提交到版本库），只写入 .env。
# MORE_API_KEY=sk-more-os-REPLACE_ME
# MCP 服务端专用密钥；留空时回退到 MORE_API_KEY。
# MORE_MCP_KEY=sk-more-os-REPLACE_ME
# 设为 1 时，未配置/格式不合法的 MORE_API_KEY 会导致启动直接报错，
# 而不是以不鉴权模式运行。生产环境建议开启。
# MORE_REQUIRE_API_KEY=0

# ── Codegen Self-Audit defaults (Step-3 · P1 gate — ON by default) ──
# best-of-k independent generations; sandbox all → differential agreement.
# 1 = disabled (save ~50% tokens on single-generation path). Default 2.
# MORE_CODEGEN_CANDIDATES=2
# Multi-agent code review panel (correctness + security + quality parallel audit).
# P1/P2 defects → re-fix loop with findings injected; P3 only → partial verdict.
# 0 = disabled (save 3 parallel LLM calls / run). Default 1 (ON).
# MORE_CODEGEN_REVIEW=1

# ── BaiLongma Fusion — Step-4 P0 (two-process, opt-in) ──────────────
# Enable a chassis sidecar reachable via A2A-over-HTTP.
# Leave empty to disable the bridge entirely (observability still runs
# locally-only).
# MORE_BAILONGMA_ENDPOINT=http://localhost:8090/rpc

# Transport: only "a2a" supported at P0; "jsonrpc_sandbox" is P1.
# MORE_BAILONGMA_BRIDGE=a2a

# When True AND endpoint is reachable, code-family tasks are delegated
# through the chassis bridge.  Default False = telemetry-only (ping/echo
# + observability link, no delegation).
# MORE_BAILONGMA_DELEGATION=0

# Override for the cross-runtime observability SQLite file.  The default
# lives inside <project_root>/logs/observability.sqlite — only set this
# when you want two runtimes to share a single file on disk (e.g.
# /var/lib/qnm/observability.sqlite on a shared volume).
# MORE_BAILONGMA_OBS_DB=